# Copy to .env for local dev, and set the same keys in the Cloudflare Pages
# dashboard for production. Only PUBLIC_* vars reach the browser.

# Where the lead form posts.
#
# The default is FormSubmit with the destination address in plain text, which
# works immediately but puts the address in the page source for scrapers.
# After activating FormSubmit (click the link in its first confirmation email),
# replace this with the hashed token endpoint it gives you:
#   PUBLIC_FORM_ENDPOINT=https://formsubmit.co/<your-token>
PUBLIC_FORM_ENDPOINT=https://formsubmit.co/lyj898@gmail.com

# GA4 measurement ID. Leave unset and no analytics is rendered at all.
# PUBLIC_GA4_ID=G-XXXXXXXXXX
