# Copy to .env for local dev. Production values are repo variables (Settings ->
# Secrets and variables -> Actions -> Variables). Only PUBLIC_* vars reach the browser.

# Where the lead form posts: FormSubmit's alias for the family inbox, so the
# inbox address is never in the page source. This is also the default in
# LeadForm.astro. Use this plain form, not /ajax/: the form adds /ajax/ itself.
PUBLIC_FORM_ENDPOINT=https://formsubmit.co/1aacc4903352135bb0fa38c3987d3abd

# GA4 measurement ID. Leave unset and no analytics is rendered at all.
# PUBLIC_GA4_ID=G-XXXXXXXXXX
