---
/**
 * The enquiry form is the only contact channel on this site. There are no
 * WhatsApp, phone or email CTAs anywhere by design.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import LeadForm from '../components/LeadForm.astro';
import { company } from '../lib/data';
import { paths } from '../lib/urls';
import type { Crumb } from '../lib/schema';

const crumbs: Crumb[] = [
  { name: 'Home', path: paths.home },
  { name: 'Get quotes', path: paths.contact },
];
---

<BaseLayout
  title="Get Moving Quotes in Singapore | HomeToMoved"
  description="Tell us about your move in seven quick steps and we will match you with vetted, insured Singapore movers. Free, and no obligation."
  path={paths.contact}
  crumbs={crumbs}
  bare={true}
>
  <section class="border-b border-line bg-paper-warm">
    <div class="wrap py-12 text-center md:py-16">
      <p class="eyebrow">Get matched</p>
      <h1 class="mt-3 text-[length:var(--text-display)]">Tell us about your move</h1>
      <p class="mx-auto mt-5 max-w-2xl text-lg leading-relaxed text-ink-soft">
        Seven quick questions, about two minutes. We pass your enquiry to vetted, insured movers who handle
        your kind of job, and they come back to you with quotes.
      </p>
      <p class="mx-auto mt-4 max-w-2xl text-[0.95rem] text-ink-soft">{company.businessModelStatement}</p>
    </div>
  </section>

  <section class="wrap py-12 md:py-16">
    <LeadForm />
  </section>

  <section class="border-t border-line bg-paper-warm">
    <div class="wrap wrap-narrow py-12 text-center">
      <p class="text-[0.95rem] text-ink-soft">
        We reply within one working day. Operating hours are{' '}
        {company.operatingHours.map((h) => h.label).join(' and ')}.
      </p>
      <p class="mt-3 text-[0.95rem] text-ink-soft">
        Your details are handled under the PDPA and are passed only to the movers we match you with. See our{' '}
        <a href={paths.privacy} class="font-semibold text-brand-deep underline underline-offset-4">privacy policy</a>.
      </p>
    </div>
  </section>
</BaseLayout>
