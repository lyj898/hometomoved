---
/**
 * About. Says who runs the site: the OurKampung team. No company runs it, so
 * none is named, and nothing here is borrowed from SKAP or Junk to Clear (no
 * founding year, no years of experience, no trading name). Independence,
 * 6 Oct 2026, jtc-family/briefs/independence.md.
 *
 * It also carries the one in-text link to OurKampung's /our-sites/, the
 * family's mother site (family revamp, 5 Oct 2026).
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { company } from '../lib/data';
import { paths } from '../lib/urls';
import type { Crumb } from '../lib/schema';

const crumbs: Crumb[] = [
  { name: 'Home', path: paths.home },
  { name: 'About', path: paths.about },
];
---

<BaseLayout
  title="About HomeToMoved | Singapore Mover Matching"
  description="HomeToMoved matches Singapore households and businesses with vetted, insured movers. It is part of OurKampung, run by the OurKampung team."
  path={paths.about}
  crumbs={crumbs}
>
  <h1>About {company.brandName}</h1>
  <p>{company.businessModelStatement}</p>

  <h2>Who runs it</h2>
  <p>
    {company.brandName} is run by the {company.family.name} team. It is one of a small family of service sites
    and guides run by the same team, all listed on
    <a href={company.family.sitesUrl}>OurKampung's page about our sites</a>.
  </p>
  <p>We operate {company.operatingHours.map((h) => h.label).join(' and ')}.</p>

  <h2>How a match works</h2>
  <ol>
    <li>
      You tell us about the move on the <a href={paths.contact}>enquiry form</a>: what you are moving out of,
      where from and where to, when, and anything awkward about the access.
    </li>
    <li>
      We read it and pass it to vendors who handle that kind of move and have passed
      <a href={paths.vendorStandards}>our checks</a>.
    </li>
    <li>They contact you directly with quotes.</li>
    <li>You compare the quotes and choose. The contract for the move is between you and that vendor.</li>
  </ol>
  <p>Matching is free to use. You pay the mover you choose, not us.</p>

  <h2>Why we check rather than move</h2>
  <p>
    A quote tells you the price. It does not tell you whether the business is registered, whether its
    insurance is in date, whether its crew can legally work in your home, or whether its surcharges are in
    writing. Those are the things that decide what happens when a move goes wrong, and they are hard for a
    household to check from a single phone call. So that is the part we take on, before any vendor can
    receive an enquiry.
  </p>

  <h2>What we do and do not do</h2>
  <p>
    We take your requirements and pass them to moving vendors who have passed our checks. We do not own
    lorries, employ movers or carry out any move. The contract for the move itself is between you and the
    vendor you choose. <a href={paths.vendorStandards}>How we vet movers</a>.
  </p>
</BaseLayout>
