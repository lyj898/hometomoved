---
/**
 * Homepage.
 *
 * No raster imagery anywhere on this page. That is a performance decision, not
 * an aesthetic shortfall: the LCP element is text, there is nothing to lazy
 * load, and there is no image to cause layout shift. The few icons are inline
 * SVG with explicit width and height.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import EntityLink from '../components/EntityLink.astro';
import FaqList from '../components/FaqList.astro';
import { publishedServices, company, locations, publishedCombosForTown } from '../lib/data';
import { paths } from '../lib/urls';
import type { Faq } from '../types';
import siteFaqsJson from '../data/site-faqs.json';

const siteFaqs = siteFaqsJson as Faq[];

const steps = [
  {
    title: 'Tell us about the move',
    body: 'Property type, town, date and roughly what needs shifting. Two minutes, and the more you say about lift size and access, the tighter the quotes come back.',
  },
  {
    title: 'We match you with vetted movers',
    body: 'Your enquiry goes to vendors who have passed our checks and who actually do that kind of job, whether that is a maisonette staircase or an after-hours office move.',
  },
  {
    title: 'You compare and choose',
    body: 'Quotes come to you directly. You pick the mover, and the contract for the move is between you and them. We are not in the middle of it.',
  },
];

/** Headline prices, straight from services.json. No figures live in this file. */
const snapshot = publishedServices
  .filter((service) => service.priceRangeSGD.min !== null)
  .map((service) => ({
    name: service.name,
    slug: service.slug,
    from: service.priceRangeSGD.min as number,
    unit: service.priceRangeSGD.unit,
  }));
---

<BaseLayout
  title="House Moving Services in Singapore | HomeToMoved"
  description="Get matched with vetted, insured Singapore movers for HDB, condo, landed and office moves. Compare quotes. Operating since 2009."
  path={paths.home}
  bare={true}
>
  <!-- ============================================================= hero -- -->
  <section class="border-b border-line bg-paper-warm">
    <div class="wrap grid gap-10 py-16 md:grid-cols-[1.15fr_1fr] md:items-center md:py-24">
      <div>
        <p class="eyebrow">Singapore &middot; Since {company.yearEstablished}</p>
        <h1 class="mt-4 text-[length:var(--text-display)]">
          Moving house in Singapore, matched to the right mover.
        </h1>
        <p class="mt-5 max-w-xl text-lg leading-relaxed text-ink-soft">
          We are not a moving company. We are the people who check them. Tell us about your move and we will
          put it in front of vetted, insured vendors who handle that kind of job &mdash; then you compare
          quotes and choose.
        </p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a href={paths.contact} class="btn btn-primary">Get matched with movers</a>
          <a href={paths.pricing} class="btn btn-secondary">See what it costs</a>
        </div>
        <p class="mt-4 text-sm text-ink-faint">
          Free to use. You pay the mover you choose, not us.
        </p>
      </div>

      <!-- Decorative rule-and-numeral panel. Pure CSS, nothing to load. -->
      <div class="hidden border-l border-line-strong pl-8 md:block" aria-hidden="true">
        <p class="font-serif text-[4.5rem] leading-none text-brand">27</p>
        <p class="mt-2 text-sm uppercase tracking-widest text-ink-faint">residential towns covered</p>
        <p class="mt-8 font-serif text-[4.5rem] leading-none text-brand">7</p>
        <p class="mt-2 text-sm uppercase tracking-widest text-ink-faint">types of move</p>
      </div>
    </div>
  </section>

  <!-- ======================================================== trust bar -- -->
  <section class="border-b border-line bg-navy text-paper" aria-label="Why us">
    <div class="wrap grid gap-6 py-8 sm:grid-cols-3">
      <div>
        <p class="font-serif text-xl">Operating since {company.yearEstablished}</p>
        <p class="mt-1 text-sm text-paper/65"><EntityLink class="underline underline-offset-2 hover:text-white" />, trading as {company.tradingName}</p>
      </div>
      <div>
        <p class="font-serif text-xl">Vetted, insured vendors</p>
        <p class="mt-1 text-sm text-paper/65">
          Registration, insurance and work passes checked &mdash;
          <a href={paths.vendorStandards} class="text-paper underline underline-offset-2">see the standards</a>
        </p>
      </div>
      <div>
        <p class="font-serif text-xl">Singapore only</p>
        <p class="mt-1 text-sm text-paper/65">HDB, condo, landed and commercial. No overseas relocations.</p>
      </div>
    </div>
  </section>

  <!-- ========================================================= services -- -->
  <section class="wrap py-16 md:py-24" aria-labelledby="services-heading">
    <p class="eyebrow">What we match</p>
    <h2 id="services-heading" class="mt-3 text-[length:var(--text-h2)]">Every kind of move</h2>
    <p class="mt-4 max-w-2xl text-ink-soft">
      Different jobs need different vendors. A grand piano down three flights and a thirty-desk office
      relocation are not the same trade.
    </p>

    <ul class="mt-10 grid gap-px border border-line bg-line sm:grid-cols-2 lg:grid-cols-3">
      {
        publishedServices.map((service) => (
          <li class="bg-paper">
            <a href={paths.service(service.slug)} class="block h-full p-6 no-underline transition-colors hover:bg-paper-warm">
              <h3 class="text-[length:var(--text-h3)] text-ink">{service.name}</h3>
              <p class="mt-2 text-[0.95rem] leading-relaxed text-ink-soft">{service.shortDescription}</p>
              <p class="mt-4 text-sm font-semibold text-brand-deep">
                {service.priceRangeSGD.min !== null ? `From S$${service.priceRangeSGD.min}` : 'Quoted per job'}
                <span aria-hidden="true"> &rarr;</span>
              </p>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- ============================================================ steps -- -->
  <section class="border-y border-line bg-paper-warm" aria-labelledby="how-heading">
    <div class="wrap py-16 md:py-24">
      <p class="eyebrow">How it works</p>
      <h2 id="how-heading" class="mt-3 text-[length:var(--text-h2)]">Three steps, and you are dealing direct</h2>

      <ol class="mt-10 grid gap-10 md:grid-cols-3">
        {
          steps.map((step, i) => (
            <li>
              <p class="font-serif text-3xl text-brand">{String(i + 1).padStart(2, '0')}</p>
              <h3 class="mt-3 text-[length:var(--text-h3)]">{step.title}</h3>
              <p class="mt-2 text-[0.95rem] leading-relaxed text-ink-soft">{step.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- ============================================================ areas -- -->
  <section class="wrap py-16 md:py-24" aria-labelledby="areas-heading">
    <p class="eyebrow">Coverage</p>
    <h2 id="areas-heading" class="mt-3 text-[length:var(--text-h2)]">All {locations.length} residential towns</h2>
    <p class="mt-4 max-w-2xl text-ink-soft">
      We match island-wide. Where a town has its own page, it is because we have something specific to say
      about moving there &mdash; the walk-ups in Geylang, the lift cars in Toa Payoh, the landed lanes in Bedok.
    </p>

    <ul class="mt-8 flex flex-wrap gap-2">
      {
        locations.map((town) => {
          const live = publishedCombosForTown(town.slug);
          const classes = 'inline-block border border-line px-3 py-1.5 text-[0.9rem]';
          return (
            <li>
              {live.length > 0 && live[0] ? (
                <a
                  href={paths.location(live[0].serviceSlug, town.slug)}
                  class={`${classes} bg-paper text-ink no-underline hover:border-brand hover:text-brand-deep`}
                >
                  {town.name}
                </a>
              ) : (
                <span class={`${classes} text-ink-faint`}>{town.name}</span>
              )}
            </li>
          );
        })
      }
    </ul>
    <p class="mt-6">
      <a href={paths.areas} class="font-semibold text-brand-deep underline underline-offset-4">
        See areas we cover
      </a>
    </p>
  </section>

  <!-- ========================================================== pricing -- -->
  <section class="border-y border-line bg-paper-warm" aria-labelledby="pricing-heading">
    <div class="wrap py-16 md:py-24">
      <p class="eyebrow">What it costs</p>
      <h2 id="pricing-heading" class="mt-3 text-[length:var(--text-h2)]">Market rates, stated plainly</h2>
      <p class="mt-4 max-w-2xl text-ink-soft">
        These are what movers charge in Singapore, not what we charge &mdash; you pay the vendor. Knowing the
        range is how you tell a fair quote from a bad one.
      </p>

      <div class="mt-10 overflow-x-auto">
        <table class="w-full min-w-[34rem] border-collapse text-left">
          <caption class="sr-only">Typical starting prices by service</caption>
          <thead>
            <tr class="border-b border-line-strong text-sm uppercase tracking-wider text-ink-faint">
              <th scope="col" class="py-3 pr-4 font-semibold">Service</th>
              <th scope="col" class="py-3 pr-4 font-semibold">From</th>
              <th scope="col" class="py-3 font-semibold">Basis</th>
            </tr>
          </thead>
          <tbody>
            {
              snapshot.map((row) => (
                <tr class="border-b border-line align-top">
                  <td class="py-4 pr-4 font-medium">
                    <a href={paths.service(row.slug)} class="text-ink no-underline hover:text-brand-deep">
                      {row.name}
                    </a>
                  </td>
                  <td class="py-4 pr-4 whitespace-nowrap font-semibold text-brand-deep">S${row.from}</td>
                  <td class="py-4 text-[0.9rem] text-ink-soft">{row.unit}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <p class="mt-6 text-sm text-ink-faint">{company.gstPosition}</p>
      <p class="mt-4">
        <a href={paths.pricing} class="font-semibold text-brand-deep underline underline-offset-4">
          Full pricing guide
        </a>
      </p>
    </div>
  </section>

  <!-- ============================================================= faqs -- -->
  <section class="wrap wrap-narrow py-16 md:py-24" aria-labelledby="faq-heading">
    <p class="eyebrow">Questions</p>
    <h2 id="faq-heading" class="mt-3 mb-8 text-[length:var(--text-h2)]">Before you enquire</h2>
    <FaqList faqs={siteFaqs} />
  </section>

  <!-- ======================================================== final cta -- -->
  <section class="bg-navy text-paper">
    <div class="wrap wrap-narrow py-16 text-center md:py-24">
      <h2 class="text-[length:var(--text-h2)]">Tell us about your move</h2>
      <p class="mx-auto mt-4 max-w-xl text-paper/75">
        Property type, town and date is enough to start. We will match you with vetted movers who do that
        kind of job.
      </p>
      <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
        <a href={paths.contact} class="btn btn-on-dark">Get matched with movers</a>
      </div>
    </div>
  </section>
</BaseLayout>
