---
/**
 * GA4. Renders nothing unless PUBLIC_GA4_ID is set, so local builds and
 * previews stay clean and no half-configured tag ships.
 *
 * Loaded with `defer` rather than in-head blocking: the location page has the
 * least performance headroom on the site and analytics should not spend it.
 *
 * Events the site sends itself, both from LeadForm.astro on /contact/:
 *   lead_form_start — first real interaction with the lead form. Not a key event.
 *   generate_lead   — once, only after FormSubmit confirms the enquiry was
 *                     accepted. The only key event.
 *
 * Never form_start or form_submit: enhanced measurement sends those itself,
 * and form_submit fires on every attempt, including failed ones (family
 * standard, jtc-family/PORTFOLIO.md). There is deliberately no generic
 * button_click event.
 */
// CI passes an unset repo variable as '' rather than undefined, so trim to a
// single falsy value. A malformed ID throws instead of silently collecting
// nothing -- the same failure mode that shipped an empty form action.
const configuredId = (import.meta.env.PUBLIC_GA4_ID ?? '').trim();
if (configuredId && !/^G-[A-Z0-9]{6,12}$/.test(configuredId)) {
  throw new Error(`PUBLIC_GA4_ID is not a valid GA4 measurement ID: "${configuredId}"`);
}
const measurementId = configuredId || null;
---

{
  measurementId && (
    <>
      <script is:inline defer src={`https://www.googletagmanager.com/gtag/js?id=${measurementId}`} />
      <script is:inline define:vars={{ measurementId }}>
        window.dataLayer = window.dataLayer || [];
        function gtag() {
          window.dataLayer.push(arguments);
        }
        window.gtag = gtag;
        gtag('js', new Date());
        gtag('config', measurementId);
      </script>
    </>
  )
}
