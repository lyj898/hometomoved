---
/**
 * Footer.
 *
 * Carries the brand and the matching-service statement, and deliberately no
 * company name, UEN or contact details: no company runs the site
 * (independence, 6 Oct 2026), and the enquiry form is the only channel.
 *
 * The one family link here is "Part of OurKampung", the family's mother site
 * (OurKampung family revamp, 5 Oct 2026, jtc-family/briefs/family-revamp.md).
 * It is nofollow because it is for readers, not rankings, and never
 * noreferrer, so GA4 still credits the visit. No footer links to the sister
 * sites themselves, and none to Junk to Clear, which is not a family site.
 */
import { publishedServices, company } from '../lib/data';
import { paths } from '../lib/urls';

const year = 2026;
---

<footer class="mt-24 border-t border-line bg-navy text-paper">
  <div class="wrap py-14">
    <div class="grid gap-10 md:grid-cols-[1.4fr_1fr_1fr]">
      <div>
        <p class="font-serif text-xl font-semibold">{company.brandName}</p>
        <p class="mt-3 max-w-sm text-[0.95rem] leading-relaxed text-paper/70">
          {company.businessModelStatement}
        </p>
      </div>

      <div>
        <p class="eyebrow-light">Services</p>
        <ul class="mt-3 space-y-1.5 text-[0.95rem]">
          {
            publishedServices.map((service) => (
              <li>
                <a href={paths.service(service.slug)} class="text-paper/80 no-underline hover:text-white">
                  {service.name}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <p class="eyebrow-light">Company</p>
        <ul class="mt-3 space-y-1.5 text-[0.95rem]">
          <li><a href={paths.vendorStandards} class="text-paper/80 no-underline hover:text-white">How we vet movers</a></li>
          <li><a href={paths.pricing} class="text-paper/80 no-underline hover:text-white">Pricing guide</a></li>
          <li><a href={paths.areas} class="text-paper/80 no-underline hover:text-white">Areas we cover</a></li>
          <li><a href={paths.about} class="text-paper/80 no-underline hover:text-white">About</a></li>
          <li><a href={paths.contact} class="text-paper/80 no-underline hover:text-white">Contact</a></li>
          <li><a href={paths.privacy} class="text-paper/80 no-underline hover:text-white">Privacy policy</a></li>
          <li><a href={paths.terms} class="text-paper/80 no-underline hover:text-white">Terms of service</a></li>
        </ul>
      </div>
    </div>

    <div class="mt-12 border-t border-white/15 pt-8 text-[0.875rem] leading-relaxed text-paper/65">
      <p>{company.operatingHours.map((h) => h.label).join(' · ')}</p>
      <p class="mt-3">
        Part of <a href={company.family.url} rel="nofollow" class="text-paper/80 underline underline-offset-2 hover:text-white">{company.family.name}</a>.
      </p>
      <p class="mt-3">Singapore only. &copy; {year} {company.brandName}.</p>
    </div>
  </div>
</footer>
