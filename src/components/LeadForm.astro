---
/**
 * Multi-step lead form, following the OurKampung planner pattern: a numbered
 * progress rail, one question per panel, selectable option cards, a review
 * step, then submit.
 *
 * Submission is sent by fetch to FormSubmit's JSON endpoint and acknowledged
 * inline, so the user never leaves the site. The earlier native POST handed
 * them to formsubmit.co and depended on it redirecting back -- when that did
 * not happen they were stranded on a third-party page with no confirmation.
 *
 * The form keeps method and action, so with JavaScript off it still posts
 * natively and _next carries the user to /thank-you/.
 *
 * The endpoint is configurable: set PUBLIC_FORM_ENDPOINT to override. After
 * activating FormSubmit, switch it to the hashed token endpoint so the
 * destination address is not sitting in the page source for scrapers.
 *
 * Option cards are buttons, not inputs, so each selection is mirrored into a
 * hidden input that FormSubmit actually receives.
 *
 * No localStorage or sessionStorage. Progress is held in memory only.
 */
import { locations, publishedServices, company } from '../lib/data';
import { paths } from '../lib/urls';
import optionsJson from '../data/form-options.json';

interface OptionCard {
  value: string;
  hint: string;
}
interface FormOptions {
  propertyTypes: OptionCard[];
  accessNotes: OptionCard[];
  extras: OptionCard[];
  timing: OptionCard[];
  serviceHints: Record<string, string>;
  destinationExtra: { slug: string; name: string }[];
}
const options = optionsJson as FormOptions;

interface Props {
  /** Preselects the service when the form is reached from a service page. */
  serviceName?: string;
  /** Preselects "moving from" when reached from a location page. */
  townName?: string;
}
const { serviceName, townName } = Astro.props;

// ?? is wrong here: CI passes an UNSET repo variable as an empty string, not
// undefined, which produced action="" on the live site and silently posted
// every lead back to /contact/. Fall back on any blank value, then assert.
const configured = import.meta.env.PUBLIC_FORM_ENDPOINT;
const endpoint = (configured && configured.trim()) || 'https://formsubmit.co/lyj898@gmail.com';
if (!endpoint.startsWith('https://')) {
  throw new Error(
    `Lead form endpoint is not an https URL: "${endpoint}". Check PUBLIC_FORM_ENDPOINT.`,
  );
}
// FormSubmit exposes the same target at /ajax/<target>, which returns JSON and
// CORS headers instead of redirecting. Only derived for formsubmit.co; any
// other endpoint falls back to the native POST.
const ajaxEndpoint = endpoint.startsWith('https://formsubmit.co/')
  ? endpoint.replace('https://formsubmit.co/', 'https://formsubmit.co/ajax/')
  : '';

const siteUrl = 'https://hometomoved.com';

// Labels come from services.json so a CTA arriving with ?service=<name>
// always matches an option exactly.
const services = publishedServices.map((s) => ({
  value: s.name,
  hint: options.serviceHints[s.slug] ?? '',
}));

const steps = ['Move type', 'Property', 'From and to', 'Date', 'Extras', 'Your details', 'Review'];
---

<form
  id="lead-form"
  method="POST"
  action={endpoint}
  novalidate
  class="mx-auto max-w-2xl"
  data-preset-service={serviceName ?? ''}
  data-preset-town={townName ?? ''}
  data-ajax-endpoint={ajaxEndpoint}
>
  {/* ---- FormSubmit control fields ---- */}
  <input type="hidden" name="_subject" value="New moving enquiry - hometomoved.com" />
  <input type="hidden" name="_template" value="table" />
  <input type="hidden" name="_captcha" value="false" />
  <input type="hidden" name="_next" value={`${siteUrl}/thank-you/`} />
  {/* Honeypot. Bots fill it, humans never see it. */}
  <input type="text" name="_honey" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />

  {/* ---- values mirrored from the option cards ---- */}
  <input type="hidden" name="Move type" id="f-service" />
  <input type="hidden" name="Property type" id="f-property" />
  <input type="hidden" name="Access notes" id="f-access" />
  <input type="hidden" name="Date flexibility" id="f-timing" />
  <input type="hidden" name="Extras needed" id="f-extras" />
  <input type="hidden" name="Page enquired from" id="f-source" />

  {/* ------------------------------------------------------ progress rail -- */}
  <div class="mb-10">
    <ol class="flex flex-wrap gap-x-4 gap-y-1 text-[0.75rem] uppercase tracking-wider text-ink-faint">
      {
        steps.map((label, i) => (
          <li data-rail={i} class="flex items-center gap-1.5">
            <span class="rail-num inline-flex h-5 w-5 items-center justify-center rounded-full border border-line-strong text-[0.7rem]">
              {i + 1}
            </span>
            <span class="rail-label hidden sm:inline">{label}</span>
          </li>
        ))
      }
    </ol>
    <div class="mt-3 h-1 w-full bg-line">
      <div id="progress-bar" class="h-1 bg-brand transition-all duration-300" style="width:14%"></div>
    </div>
    <p class="mt-3 text-sm font-semibold text-brand" id="step-counter">Step 1 of 7</p>
  </div>

  {/* ================================================== 0 — move type == */}
  <fieldset class="step" data-step="0">
    <legend class="text-[length:var(--text-h2)] font-serif font-semibold">What kind of move is it?</legend>
    <p class="mt-2 text-ink-soft">Pick the closest match. We will confirm the details with you.</p>
    <div class="opt-grid mt-6 grid gap-3 sm:grid-cols-2" data-field="f-service" data-single>
      {
        services.map((o) => (
          <button type="button" class="opt" data-value={o.value}>
            <span class="opt-label">{o.value}</span>
            <span class="opt-hint">{o.hint}</span>
          </button>
        ))
      }
    </div>
  </fieldset>

  {/* =================================================== 1 — property == */}
  <fieldset class="step hidden" data-step="1">
    <legend class="text-[length:var(--text-h2)] font-serif font-semibold">What are you moving out of?</legend>
    <p class="mt-2 text-ink-soft">Flat type drives the lorry size and the crew count more than anything else.</p>
    <div class="opt-grid mt-6 grid gap-3 sm:grid-cols-2" data-field="f-property" data-single>
      {
        options.propertyTypes.map((o) => (
          <button type="button" class="opt" data-value={o.value}>
            <span class="opt-label">{o.value}</span>
            <span class="opt-hint">{o.hint}</span>
          </button>
        ))
      }
    </div>

    <p class="mt-8 font-medium">Anything awkward about the access?</p>
    <p class="mt-1 text-[0.9rem] text-ink-soft">Choose any that apply. This is what stops a quote changing on the day.</p>
    <div class="opt-grid mt-4 grid gap-3 sm:grid-cols-2" data-field="f-access">
      {
        options.accessNotes.map((o) => (
          <button type="button" class="opt" data-value={o.value}>
            <span class="opt-label">{o.value}</span>
            <span class="opt-hint">{o.hint}</span>
          </button>
        ))
      }
    </div>
  </fieldset>

  {/* ================================================ 2 — from and to == */}
  <fieldset class="step hidden" data-step="2">
    <legend class="text-[length:var(--text-h2)] font-serif font-semibold">Where from, and where to?</legend>
    <p class="mt-2 text-ink-soft">We match you with movers who work in your area regularly.</p>

    <div class="mt-6 grid gap-5 sm:grid-cols-2">
      <div>
        <label for="from-town" class="field-label">Moving from</label>
        <select id="from-town" name="Moving from" class="field" required>
          <option value="">Select a town</option>
          {locations.map((t) => <option value={t.name}>{t.name}</option>)}
        </select>
      </div>
      <div>
        <label for="to-town" class="field-label">Moving to</label>
        <select id="to-town" name="Moving to" class="field" required>
          <option value="">Select a town</option>
          {locations.map((t) => <option value={t.name}>{t.name}</option>)}
          {options.destinationExtra.map((d) => <option value={d.name}>{d.name}</option>)}
        </select>
      </div>
    </div>

    <div class="mt-5">
      <label for="floors" class="field-label">Floor at each end <span class="opt-hint">(optional)</span></label>
      <input
        type="text"
        id="floors"
        name="Floors"
        class="field"
        placeholder="e.g. from #12-345, to #03-21 walk-up"
        autocomplete="off"
      />
    </div>
  </fieldset>

  {/* ======================================================= 3 — date == */}
  <fieldset class="step hidden" data-step="3">
    <legend class="text-[length:var(--text-h2)] font-serif font-semibold">When do you need to move?</legend>
    <p class="mt-2 text-ink-soft">
      Month end, weekends and the weeks before Chinese New Year are the tightest slots and often carry a surcharge.
    </p>
    <div class="mt-6 max-w-xs">
      <label for="move-date" class="field-label">Preferred date</label>
      <input type="date" id="move-date" name="Preferred date" class="field" />
    </div>
    <div class="opt-grid mt-6 grid gap-3 sm:grid-cols-2" data-field="f-timing" data-single>
      {
        options.timing.map((o) => (
          <button type="button" class="opt" data-value={o.value}>
            <span class="opt-label">{o.value}</span>
            <span class="opt-hint">{o.hint}</span>
          </button>
        ))
      }
    </div>
  </fieldset>

  {/* ===================================================== 4 — extras == */}
  <fieldset class="step hidden" data-step="4">
    <legend class="text-[length:var(--text-h2)] font-serif font-semibold">Anything beyond the move itself?</legend>
    <p class="mt-2 text-ink-soft">Choose as many as apply. Booking these together usually costs less than separately.</p>
    <div class="opt-grid mt-6 grid gap-3 sm:grid-cols-2" data-field="f-extras">
      {
        options.extras.map((o) => (
          <button type="button" class="opt" data-value={o.value}>
            <span class="opt-label">{o.value}</span>
            <span class="opt-hint">{o.hint}</span>
          </button>
        ))
      }
    </div>
  </fieldset>

  {/* ============================================== 5 — your details == */}
  <fieldset class="step hidden" data-step="5">
    <legend class="text-[length:var(--text-h2)] font-serif font-semibold">Where should the quotes go?</legend>
    <p class="mt-2 text-ink-soft">We reply within one working day, usually sooner.</p>

    <div class="mt-6 space-y-5">
      <div>
        <label for="name" class="field-label">Your name</label>
        <input type="text" id="name" name="Name" class="field" placeholder="e.g. Rachel Tan" autocomplete="name" required />
      </div>
      <div>
        <label for="phone" class="field-label">Mobile number</label>
        <input
          type="tel"
          id="phone"
          name="Phone"
          class="field"
          placeholder="e.g. 8123 4567"
          autocomplete="tel"
          inputmode="tel"
          required
        />
      </div>
      <div>
        <label for="email" class="field-label">Email</label>
        <input type="email" id="email" name="Email" class="field" placeholder="you@email.com" autocomplete="email" required />
      </div>
      <div>
        <label for="message" class="field-label">Anything else we should know? <span class="opt-hint">(optional)</span></label>
        <textarea
          id="message"
          name="Message"
          rows="4"
          class="field"
          placeholder="Fragile items, a piano, a tight lift, a date that cannot move…"></textarea>
      </div>
    </div>
  </fieldset>

  {/* ===================================================== 6 — review == */}
  <fieldset class="step hidden" data-step="6">
    <legend class="text-[length:var(--text-h2)] font-serif font-semibold">Does everything look right?</legend>
    <p class="mt-2 text-ink-soft">Give it a quick check, then send it over.</p>

    <dl id="review" class="mt-6 divide-y divide-line border-y border-line text-[0.95rem]"></dl>

    {/* PDPA consent. Unticked by default, and it names the disclosure. */}
    <div class="mt-8 border border-line-strong bg-paper-warm p-5">
      <label class="flex cursor-pointer items-start gap-3">
        <input type="checkbox" id="consent" name="PDPA consent" value="Given" class="mt-1 h-5 w-5 shrink-0 accent-[#8a5a1f]" />
        <span class="text-[0.925rem] leading-relaxed">
          I consent to <strong>{company.legalName}</strong> (trading as {company.tradingName}) collecting and
          using my personal data to contact me about this enquiry, and to
          <strong> disclosing my details to the moving vendors it matches me with</strong> so that they can
          quote for my job. I understand I can withdraw consent at any time, as set out in the{' '}
          <a href={paths.privacy} class="font-semibold text-brand-deep underline underline-offset-2">privacy policy</a>.
        </span>
      </label>
      <p id="consent-error" class="mt-3 hidden text-[0.9rem] font-semibold text-[#a11c1c]">
        Please tick the consent box so we can pass your enquiry to movers.
      </p>
    </div>
  </fieldset>

  {/* ======================================================== controls == */}
  <p id="form-error" class="mt-6 hidden border-l-4 border-[#a11c1c] bg-[#fdf0f0] px-4 py-3 text-[0.925rem] font-medium text-[#a11c1c]"></p>

  <div id="form-controls" class="mt-8 flex items-center justify-between gap-4">
    <button type="button" id="btn-back" class="btn btn-secondary invisible">Back</button>
    <button type="button" id="btn-next" class="btn btn-primary">Continue</button>
    <button type="submit" id="btn-submit" class="btn btn-primary hidden">Send my enquiry</button>
  </div>
</form>

{/*
  Inline acknowledgement. The submission is sent by fetch and the user never
  leaves the page, so what they see after sending is ours rather than a
  third-party form backend's page.
*/}
<div id="form-success" class="mx-auto hidden max-w-2xl border border-brand bg-brand-wash p-8 text-center">
  <svg class="mx-auto text-brand" width="48" height="48" viewBox="0 0 52 52" fill="none" aria-hidden="true">
    <circle cx="26" cy="26" r="24" stroke="currentColor" stroke-width="2"></circle>
    <path d="M16 26.5 23 33.5 36 19" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"></path>
  </svg>
  <h2 class="mt-5 text-[length:var(--text-h2)]">Enquiry sent</h2>
  <p class="mx-auto mt-3 max-w-md leading-relaxed text-ink-soft">
    Thanks &mdash; we have your details. We will match you with vetted, insured movers who handle your kind
    of job, and you should hear back within one working day.
  </p>
  <ol class="mx-auto mt-6 max-w-md space-y-2 text-left text-[0.95rem] text-ink-soft">
    <li><strong class="text-ink">1.</strong> We pick vendors who do this kind of move.</li>
    <li><strong class="text-ink">2.</strong> They contact you directly with quotes.</li>
    <li><strong class="text-ink">3.</strong> You compare and choose. The contract is with the mover.</li>
  </ol>
  <p class="mt-7 flex flex-wrap justify-center gap-2 text-[0.9rem]">
    <a href={paths.vendorStandards} class="border border-line bg-paper px-3 py-1.5 no-underline hover:border-brand hover:text-brand-deep">
      How we vet movers
    </a>
    <a href={paths.pricing} class="border border-line bg-paper px-3 py-1.5 no-underline hover:border-brand hover:text-brand-deep">
      Pricing guide
    </a>
  </p>
</div>

<script is:inline>
  (function () {
    var form = document.getElementById('lead-form');
    if (!form) return;

    var steps = Array.prototype.slice.call(form.querySelectorAll('.step'));
    var rails = Array.prototype.slice.call(form.querySelectorAll('[data-rail]'));
    var bar = document.getElementById('progress-bar');
    var counter = document.getElementById('step-counter');
    var back = document.getElementById('btn-back');
    var next = document.getElementById('btn-next');
    var submit = document.getElementById('btn-submit');
    var errorBox = document.getElementById('form-error');
    var review = document.getElementById('review');
    var current = 0;
    var started = false;

    document.getElementById('f-source').value = location.pathname;

    /* ---- GA4: form_start on first interaction, once ---- */
    function markStarted() {
      if (started) return;
      started = true;
      if (typeof window.gtag === 'function') {
        window.gtag('event', 'form_start', { page_path: location.pathname });
      }
    }
    form.addEventListener('focusin', markStarted);
    form.addEventListener('click', function (e) {
      if (e.target.closest('.opt')) markStarted();
    });

    /* ---- option cards mirror into hidden inputs ---- */
    Array.prototype.forEach.call(form.querySelectorAll('.opt-grid'), function (grid) {
      var target = document.getElementById(grid.getAttribute('data-field'));
      var single = grid.hasAttribute('data-single');
      grid.addEventListener('click', function (e) {
        var opt = e.target.closest('.opt');
        if (!opt) return;
        if (single) {
          Array.prototype.forEach.call(grid.querySelectorAll('.opt'), function (o) {
            o.classList.remove('is-selected');
            o.setAttribute('aria-pressed', 'false');
          });
          opt.classList.add('is-selected');
          opt.setAttribute('aria-pressed', 'true');
          target.value = opt.getAttribute('data-value');
        } else {
          var on = opt.classList.toggle('is-selected');
          opt.setAttribute('aria-pressed', on ? 'true' : 'false');
          var picked = [];
          Array.prototype.forEach.call(grid.querySelectorAll('.opt.is-selected'), function (o) {
            picked.push(o.getAttribute('data-value'));
          });
          target.value = picked.join(', ');
        }
        hideError();
      });
    });

    /* ---- preselect from the page the form was reached from ---- */
    function preselect(fieldId, wanted) {
      if (!wanted) return;
      var grid = form.querySelector('[data-field="' + fieldId + '"]');
      if (!grid) return;
      var match = Array.prototype.filter.call(grid.querySelectorAll('.opt'), function (o) {
        return o.getAttribute('data-value').toLowerCase() === wanted.toLowerCase();
      })[0];
      if (match) match.click();
    }
    // Service and location pages link here with ?service=&town=, so the form
    // opens with the move type and origin town already chosen.
    var qs = new URLSearchParams(location.search);
    preselect('f-service', qs.get('service') || form.getAttribute('data-preset-service'));
    var presetTown = qs.get('town') || form.getAttribute('data-preset-town');
    if (presetTown) {
      var fromSel = document.getElementById('from-town');
      Array.prototype.forEach.call(fromSel.options, function (o) {
        if (o.value === presetTown) fromSel.value = presetTown;
      });
    }

    function hideError() {
      errorBox.classList.add('hidden');
    }
    function showError(msg) {
      errorBox.textContent = msg;
      errorBox.classList.remove('hidden');
      errorBox.scrollIntoView({ block: 'center' });
    }

    /* ---- per-step validation ---- */
    function validate(index) {
      if (index === 0 && !document.getElementById('f-service').value) {
        showError('Please choose the kind of move.');
        return false;
      }
      if (index === 1 && !document.getElementById('f-property').value) {
        showError('Please choose what you are moving out of.');
        return false;
      }
      if (index === 2) {
        if (!document.getElementById('from-town').value) {
          showError('Please tell us which town you are moving from.');
          return false;
        }
        if (!document.getElementById('to-town').value) {
          showError('Please tell us where you are moving to.');
          return false;
        }
      }
      if (index === 5) {
        var name = document.getElementById('name');
        var phone = document.getElementById('phone');
        var email = document.getElementById('email');
        if (!name.value.trim()) {
          showError('Please tell us your name.');
          name.focus();
          return false;
        }
        if (!phone.value.trim() || phone.value.replace(/\D/g, '').length < 8) {
          showError('Please enter a valid mobile number.');
          phone.focus();
          return false;
        }
        if (!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email.value.trim())) {
          showError('Please enter a valid email address.');
          email.focus();
          return false;
        }
      }
      hideError();
      return true;
    }

    /* ---- review panel ---- */
    function buildReview() {
      var rows = [
        ['Move type', document.getElementById('f-service').value],
        ['Property', document.getElementById('f-property').value],
        ['Access', document.getElementById('f-access').value],
        ['Moving from', document.getElementById('from-town').value],
        ['Moving to', document.getElementById('to-town').value],
        ['Floors', document.getElementById('floors').value],
        ['Preferred date', document.getElementById('move-date').value],
        ['Flexibility', document.getElementById('f-timing').value],
        ['Extras', document.getElementById('f-extras').value],
        ['Name', document.getElementById('name').value],
        ['Mobile', document.getElementById('phone').value],
        ['Email', document.getElementById('email').value],
        ['Notes', document.getElementById('message').value],
      ];
      review.innerHTML = '';
      rows.forEach(function (r) {
        if (!r[1]) return;
        var dt = document.createElement('dt');
        dt.className = 'pt-3 text-[0.8rem] uppercase tracking-wider text-ink-faint';
        dt.textContent = r[0];
        var dd = document.createElement('dd');
        dd.className = 'pb-3';
        dd.textContent = r[1];
        review.appendChild(dt);
        review.appendChild(dd);
      });
    }

    function show(index, skipScroll) {
      steps.forEach(function (s, i) {
        s.classList.toggle('hidden', i !== index);
      });
      rails.forEach(function (r, i) {
        r.classList.toggle('is-done', i < index);
        r.classList.toggle('is-current', i === index);
      });
      bar.style.width = Math.round(((index + 1) / steps.length) * 100) + '%';
      counter.textContent = 'Step ' + (index + 1) + ' of ' + steps.length;
      back.classList.toggle('invisible', index === 0);
      var last = index === steps.length - 1;
      next.classList.toggle('hidden', last);
      submit.classList.toggle('hidden', !last);
      current = index;
      if (last) buildReview();
      // Not on the initial render: a smooth scroll on load costs main-thread
      // time for a scroll the user did not ask for.
      if (!skipScroll) form.scrollIntoView({ block: 'start', behavior: 'smooth' });
    }

    next.addEventListener('click', function () {
      if (!validate(current)) return;
      show(Math.min(current + 1, steps.length - 1));
    });
    back.addEventListener('click', function () {
      hideError();
      show(Math.max(current - 1, 0));
    });

    /**
     * Submit by fetch rather than letting the browser POST away.
     *
     * The native POST handed the user to the form backend's own page and
     * relied on it redirecting back. When that redirect did not happen, the
     * user was left on a third-party page with no acknowledgement and no way
     * back. Sending it ourselves keeps the confirmation on our page and lets
     * a real failure be reported as a failure instead of looking like success.
     *
     * The form keeps its method and action, so without JavaScript it still
     * posts natively and _next carries the user to /thank-you/.
     */
    form.addEventListener('submit', function (e) {
      var consent = document.getElementById('consent');
      if (!consent.checked) {
        e.preventDefault();
        document.getElementById('consent-error').classList.remove('hidden');
        consent.focus();
        return;
      }

      var ajax = form.getAttribute('data-ajax-endpoint');
      if (!ajax) return; // no AJAX endpoint: fall back to the native POST

      e.preventDefault();
      hideError();
      submit.disabled = true;
      submit.textContent = 'Sending…';

      var payload = {};
      new FormData(form).forEach(function (value, key) {
        if (key.charAt(0) !== '_') payload[key] = value;
      });
      payload._subject = 'New moving enquiry - hometomoved.com';
      payload._template = 'table';

      fetch(ajax, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify(payload),
      })
        .then(function (res) {
          return res.json().catch(function () {
            return { success: 'false', message: 'Unexpected response from the form service.' };
          });
        })
        .then(function (data) {
          if (String(data.success) !== 'true') {
            throw new Error(data.message || 'The form service rejected the submission.');
          }
          form.classList.add('hidden');
          var ok = document.getElementById('form-success');
          ok.classList.remove('hidden');
          ok.setAttribute('tabindex', '-1');
          ok.focus();
          ok.scrollIntoView({ block: 'center' });
          if (typeof window.gtag === 'function') {
            window.gtag('event', 'form_submit', { page_path: location.pathname });
          }
        })
        .catch(function (err) {
          submit.disabled = false;
          submit.textContent = 'Send my enquiry';
          showError(
            'Sorry — your enquiry did not go through. ' +
              (err && err.message ? err.message + ' ' : '') +
              'Nothing has been lost, so please try again.',
          );
        });
    });

    show(0, true);
  })();
</script>
