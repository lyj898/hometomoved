---
/**
 * Link to the operating entity's own site.
 *
 * Used on the about page only. Everywhere else the entity name is plain text,
 * which is deliberate: one outbound link from the page that explains the
 * relationship, rather than the same link repeated in every footer.
 * scripts/audit-build.mjs enforces that.
 *
 * Defaults to the brand customers would recognise (Junk to Clear) rather than
 * the registered name, since that is what the origin story refers to.
 */
import { company } from '../lib/data';

interface Props {
  /** Link text. Defaults to the parent brand name. */
  label?: string;
  class?: string;
}

const { label = company.parentBrandName, class: className = '' } = Astro.props;
---

<a href={company.entityUrl} rel="noopener" class={className || undefined}>{label}</a>
