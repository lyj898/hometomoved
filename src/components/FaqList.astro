---
/**
 * FAQ accordion built on <details>. No JavaScript, no ARIA to get wrong, and
 * the answer text is in the DOM for crawlers whether or not it is open.
 *
 * FAQPage markup is emitted by the page, not here -- and it is not a ranking
 * lever. Google deprecated FAQ rich results in May 2026. This exists because
 * stacked questions are how people actually read a page like this.
 */
import type { Faq } from '../types';

interface Props {
  faqs: Faq[];
}

const { faqs } = Astro.props;
---

<div class="divide-y divide-line border-y border-line">
  {
    faqs.map((faq) => (
      <details class="group">
        <summary
          class="flex cursor-pointer list-none items-start justify-between gap-4 py-5 font-medium marker:content-none"
        >
          <span class="text-[1.05rem]">{faq.q}</span>
          <svg
            class="mt-1 shrink-0 transition-transform group-open:rotate-45"
            width="18"
            height="18"
            viewBox="0 0 18 18"
            fill="none"
            aria-hidden="true"
          >
            <path d="M9 3v12M3 9h12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
          </svg>
        </summary>
        <p class="max-w-2xl pb-5 text-[0.975rem] leading-relaxed text-ink-soft">{faq.a}</p>
      </details>
    ))
  }
</div>
